{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "account_id": "367202bd3835ef7c831b0fd97df1bc5e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "shalinbtw.com",
      "custom_domain": true
    },
    {
      "pattern": "shalinnaidoo.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the contact API runs the Worker; everything else is a static asset.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CONTACT_FROM": "contact@shalinbtw.com"
  },
  // The inbox that receives messages. Set with `npx wrangler secret put CONTACT_TO`
  // so the address never appears in this public repository.
  "secrets": {
    "required": ["CONTACT_TO"]
  },
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "allowed_sender_addresses": ["contact@shalinbtw.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
